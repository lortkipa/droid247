{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["PORT", "HOST", "CORS_ORIGIN", "EXPO_PUBLIC_API_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": { "cache": false, "persistent": true },
    "dev:web": { "cache": false, "persistent": true },
    "dev:android": { "cache": false, "persistent": true },
    "dev:ios": { "cache": false, "persistent": true },
    "dev:mobile": { "cache": false, "persistent": true },
    "dev:desktop": { "cache": false, "persistent": true }
  }
}
