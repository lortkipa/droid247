{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "HOST",
    "CORS_ORIGIN",
    "DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "EXPO_PUBLIC_API_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": { "cache": false, "persistent": true },
    "dev:web": { "cache": false, "persistent": true },
    "dev:android": { "cache": false, "persistent": true },
    "dev:ios": { "cache": false, "persistent": true },
    "dev:mobile": { "cache": false, "persistent": true },
    "dev:desktop": { "cache": false, "persistent": true }
  }
}
