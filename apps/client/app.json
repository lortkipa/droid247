{
  "expo": {
    "name": "Droid247",
    "slug": "droid247",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon-1024.png",
    "scheme": "droid247",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "ios": {
      "bundleIdentifier": "com.droid247.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.droid247.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#0B0D12"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon-48.png",
      "name": "Droid247",
      "themeColor": "#0B0D12",
      "backgroundColor": "#0B0D12"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
