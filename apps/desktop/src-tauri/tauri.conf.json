{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Droid247",
  "version": "0.1.0",
  "identifier": "com.droid247.desktop",
  "build": {
    "devUrl": "http://localhost:8081",
    "frontendDist": "../../client/dist",
    "beforeDevCommand": "pnpm --filter @droid247/client start",
    "beforeBuildCommand": "pnpm --filter @droid247/client build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Droid247",
        "width": 1024,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "droid247"
        ]
      }
    }
  }
}
