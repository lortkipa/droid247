# Server settings go in `.env` at the repo root: `pnpm dev`, `pnpm start` and docker compose read it.
# Frontend build settings go in `apps/web/.env.production.local`.

# --- server (apps/server) ---
PORT=8787
HOST=0.0.0.0
# Comma-separated list of origins allowed to call the API from a browser/webview.
# Defaults cover the Vite dev/preview servers and the Tauri webview origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,tauri://localhost,http://tauri.localhost
# SQLite file for accounts and sessions, relative to apps/server. The Docker image uses /app/data.
DATABASE_PATH=data/droid247.db

# Email for sign-in codes. Leave SMTP_HOST empty to print codes to the server console instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com, and SMTP_PASS set to an
# app password (turn on 2-Step Verification, then create one at https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
# true for port 465. Empty means true only when SMTP_PORT=465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# e.g. droid247 <you@gmail.com>. Empty means SMTP_USER.
MAIL_FROM=

# "Continue with Google". Leave both empty to turn it off. Create an OAuth client of type
# "Web application" at https://console.cloud.google.com/apis/credentials and add
# <PUBLIC_URL>/auth/google/callback (http://localhost:8787/auth/google/callback for dev)
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where browsers reach this server. Empty means http://localhost:<PORT>.
PUBLIC_URL=

# --- frontend builds (apps/web, also used by the desktop app) ---
# Where the UI finds the backend. Empty falls back to http://localhost:8787.
VITE_API_URL=
