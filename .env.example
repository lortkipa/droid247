# Copy to `.env` (server) / `apps/web/.env.production.local` (frontend builds) as needed.

# --- server (apps/server) ---
# PORT=8787
# HOST=0.0.0.0
# Comma-separated list of origins allowed to call the API from a browser/webview.
# Defaults cover the Vite dev/preview servers and the Tauri webview origins.
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173,tauri://localhost,http://tauri.localhost

# --- frontend builds (apps/web, also used by the desktop app) ---
# Where the UI finds the backend. Falls back to http://localhost:8787 when unset.
# VITE_API_URL=https://api.example.com
