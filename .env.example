# Copy to .env (next to this file). The server and `pnpm db:*` read it.
# Everything has a working default for local development except Google sign-in.

# Server (apps/server)
PORT=3000
HOST=0.0.0.0
# Comma-separated origins of the web and desktop app. They may call the API with
# credentials and are trusted as sign-in redirect targets.
# Default: http://localhost:8081,tauri://localhost,http://tauri.localhost
CORS_ORIGIN=

# Postgres. Default: the container from `pnpm db:up`
# (postgres://droid247:droid247@localhost:5433/droid247). Required in production.
DATABASE_URL=

# Auth (Better Auth). Required in production: a random string of 32+ characters,
# e.g. from `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of the server. Google redirects to <BETTER_AUTH_URL>/api/auth/callback/google.
# Default: http://localhost:<PORT>
BETTER_AUTH_URL=

# Google sign-in. Without these the Google button shows "isn't set up".
# Create a "Web application" OAuth client in Google Cloud (see docs/setup.md#google-sign-in).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email for sign-in codes, over SMTP. Without these (development only) the code is
# printed in the server log instead. Required in production.
# Free with a Gmail account: SMTP_HOST=smtp.gmail.com, SMTP_USER=you@gmail.com and an
# app password as SMTP_PASS (see docs/setup.md#email-sign-in).
SMTP_HOST=
# 465 (TLS) or 587 (STARTTLS). Default: 465
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Sender, e.g. "Droid247 <you@gmail.com>". Default: SMTP_USER
EMAIL_FROM=

# Client (apps/client). Leave empty to use the defaults:
#   web / desktop / iOS simulator / Android emulator -> http://localhost:3000
#   physical phone (Expo Go)                         -> http://<your computer's LAN IP>:3000
EXPO_PUBLIC_API_URL=
