# Server (apps/server)
PORT=3000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins; "*" allows all (dev only).
CORS_ORIGIN=*

# Client (apps/client). Leave empty to use the defaults:
#   web / desktop / iOS simulator -> http://localhost:3000
#   Android emulator              -> http://10.0.2.2:3000
#   physical phone (Expo Go)      -> http://<your computer's LAN IP>:3000
EXPO_PUBLIC_API_URL=
